# ============================================================
# Biến môi trường của agent. Dùng: cp .env.example .env  (.env đã nằm trong .gitignore)
# File này CHỈ chứa giá trị mẫu, KHÔNG ghi secret thật vào đây.
# Comment luôn nằm trên dòng riêng: `docker run --env-file` không bỏ comment cuối dòng.
# ============================================================

# --- Server ---
PORT=8000
# development | staging | production
ENVIRONMENT=development

# --- Bảo mật ---
# Đổi thành chuỗi ngẫu nhiên dài, ví dụ:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Bắt buộc phải đặt khi ENVIRONMENT=production. Để trống thì mọi request /ask bị từ chối (401).
AGENT_API_KEY=dev-key-change-me

# --- Redis (rate limit + cost guard) ---
# docker compose tự ghi đè thành redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# --- Giới hạn ---
# Số request tối đa / 60 giây / API key. Vượt thì trả 429.
RATE_LIMIT_PER_MINUTE=10
# Tổng chi phí LLM tối đa mỗi ngày (UTC). Vượt thì trả 402.
DAILY_BUDGET_USD=1.0

# --- Tuỳ chọn ---
APP_VERSION=1.0.0
